# Alternative GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=standard
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),standard)
  CoverageTest_config = standard

else ifeq ($(config),standard_part)
  CoverageTest_config = standard_part

else ifeq ($(config),mod_cpp)
  CoverageTest_config = mod_cpp

else ifeq ($(config),macro)
  CoverageTest_config = macro

else ifeq ($(config),b_macro)
  CoverageTest_config = b_macro

else ifeq ($(config),fd_set)
  CoverageTest_config = fd_set

else ifeq ($(config),exclude)
  CoverageTest_config = exclude

else ifeq ($(config),count)
  CoverageTest_config = count

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := CoverageTest

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

CoverageTest:
ifneq (,$(CoverageTest_config))
	@echo "==== Building CoverageTest ($(CoverageTest_config)) ===="
	@${MAKE} --no-print-directory -C . -f CoverageTest.make config=$(CoverageTest_config)
endif

clean:
	@${MAKE} --no-print-directory -C . -f CoverageTest.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  standard"
	@echo "  standard_part"
	@echo "  mod_cpp"
	@echo "  macro"
	@echo "  b_macro"
	@echo "  fd_set"
	@echo "  exclude"
	@echo "  count"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   CoverageTest"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"